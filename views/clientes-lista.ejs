<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { title: 'Clientes - CRM' }) %>
</head>
<body class="bg-stone-100 min-h-screen font-sans text-stone-800">

<div class="flex">
  <%- include('partials/sidebar', { active: 'clientes' }) %>

  <main class="flex-1 p-8">
    <div class="max-w-6xl mx-auto">
      <!-- Cabeçalho -->
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-stone-900">Clientes</h1>
          <p class="text-stone-500 mt-1">Gerencie o cadastro completo dos clientes</p>
        </div>
        <a href="/admin/clientes/novo" class="bg-amber-600 hover:bg-amber-700 text-white font-medium px-4 py-2 rounded-xl transition flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          Novo Cliente
        </a>
      </div>

      <!-- Tabela de Clientes -->
      <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-stone-50 border-b border-stone-200">
                <th class="text-left py-4 px-6 text-sm font-semibold text-stone-600">Nome</th>
                <th class="text-left py-4 px-6 text-sm font-semibold text-stone-600">Telefone</th>
                <th class="text-left py-4 px-6 text-sm font-semibold text-stone-600">Endereço</th>
                <th class="text-left py-4 px-6 text-sm font-semibold text-stone-600">Pedidos</th>
                <th class="text-left py-4 px-6 text-sm font-semibold text-stone-600">Total Gasto</th>
                <th class="text-left py-4 px-6 text-sm font-semibold text-stone-600">Cadastro</th>
                <th class="text-left py-4 px-6 text-sm font-semibold text-stone-600">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% clientes.forEach(cliente => { %>
                <tr class="border-b border-stone-100 hover:bg-amber-50/30 transition">
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center">
                        <span class="text-sm font-semibold text-amber-700">
                          <%= cliente.nome ? cliente.nome.charAt(0).toUpperCase() : 'C' %>
                        </span>
                      </div>
                      <div>
                        <p class="font-medium text-stone-900"><%= cliente.nome || 'Sem nome' %></p>
                        <% if (cliente.observacoes) { %>
                          <p class="text-xs text-stone-500 truncate max-w-xs"><%= cliente.observacoes %></p>
                        <% } %>
                      </div>
                    </div>
                  </td>
                  <td class="py-4 px-6">
                    <a href="/admin/cliente/<%= cliente.telefone %>" class="text-amber-600 hover:text-amber-700 font-medium hover:underline flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <%= cliente.telefone %>
                    </a>
                  </td>
                  <td class="py-4 px-6 text-sm text-stone-600">
                    <% if (cliente.endereco) { %>
                      <span class="inline-flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <%= cliente.endereco %>
                      </span>
                    <% } else { %>
                      <span class="text-stone-400">Sem endereço</span>
                    <% } %>
                  </td>
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-blue-100 text-blue-800">
                      <%= cliente.total_pedidos || 0 %> pedidos
                    </span>
                  </td>
                  <td class="py-4 px-6 font-semibold text-green-700">
                    R$ <%= Number(cliente.valor_total || 0).toFixed(2) %>
                  </td>
                  <td class="py-4 px-6 text-sm text-stone-600">
                    <%= new Date(cliente.criado_em).toLocaleDateString('pt-BR') %>
                  </td>
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-2">
                      <a href="/admin/clientes/<%= cliente.telefone %>/editar" class="text-amber-600 hover:text-amber-700 p-1 hover:bg-amber-50 rounded-lg transition" title="Editar">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                      </a>
                      <form method="POST" action="/admin/clientes/<%= cliente.telefone %>/excluir" onsubmit="return confirm('Tem certeza que deseja excluir este cliente?')" class="inline">
                        <button type="submit" class="text-red-600 hover:text-red-700 p-1 hover:bg-red-50 rounded-lg transition" title="Excluir">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                          </svg>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% if (clientes.length === 0) { %>
          <div class="py-12 text-center text-stone-500">
            <svg class="w-12 h-12 mx-auto mb-4 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <p>Nenhum cliente cadastrado ainda.</p>
            <a href="/admin/clientes/novo" class="text-amber-600 hover:text-amber-700 font-medium mt-2 inline-block">
              Cadastrar primeiro cliente →
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

</body>
</html>
