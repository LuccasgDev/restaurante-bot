<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { title: 'Detalhes do Cliente' }) %>
</head>
<body class="bg-stone-100 min-h-screen font-sans text-stone-800">

<div class="flex">
  <%- include('partials/sidebar', { active: 'dashboard' }) %>

  <main class="flex-1 p-8">
    <div class="max-w-6xl mx-auto">
      <!-- Cabeçalho -->
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-stone-900">Detalhes do Cliente</h1>
          <p class="text-stone-500 mt-1">Histórico completo e informações de contato</p>
        </div>
        <a href="/admin/dashboard" class="text-amber-600 hover:text-amber-700 font-medium flex items-center gap-2">
          ← Voltar ao Dashboard
        </a>
      </div>

      <!-- Informações do Cliente -->
      <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 p-6 mb-6">
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center">
              <svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-stone-900"><%= cliente.nome || 'Cliente' %></h2>
              <p class="text-amber-600 font-medium"><%= cliente.telefone %></p>
              <% if (cliente.endereco) { %>
                <p class="text-stone-600 text-sm mt-1">📍 <%= cliente.endereco %></p>
              <% } %>
            </div>
          </div>
          <div class="text-right">
            <p class="text-sm text-stone-500">Cliente desde</p>
            <p class="font-semibold text-stone-900"><%= new Date(cliente.criado_em).toLocaleDateString('pt-BR') %></p>
          </div>
        </div>
      </div>

      <!-- Estatísticas -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 p-6">
          <p class="text-stone-500 text-sm font-medium mb-1">Total de Pedidos</p>
          <p class="text-2xl font-bold text-blue-600 mt-1"><%= estatisticas.totalPedidos %></p>
        </div>
        <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 p-6">
          <p class="text-stone-500 text-sm font-medium mb-1">Pedidos Finalizados</p>
          <p class="text-2xl font-bold text-green-600 mt-1"><%= estatisticas.pedidosFinalizados %></p>
        </div>
        <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 p-6">
          <p class="text-stone-500 text-sm font-medium mb-1">Valor Total</p>
          <p class="text-2xl font-bold text-amber-600 mt-1">R$ <%= Number(estatisticas.valorTotal).toFixed(2) %></p>
        </div>
        <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 p-6">
          <p class="text-stone-500 text-sm font-medium mb-1">Ticket Médio</p>
          <p class="text-2xl font-bold text-purple-600 mt-1">R$ <%= Number(estatisticas.ticketMedio).toFixed(2) %></p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Pratos Favoritos -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 p-6">
            <h3 class="text-lg font-semibold text-stone-900 mb-4">🍽️ Pratos Favoritos</h3>
            <% if (estatisticas.pratosFavoritos.length > 0) { %>
              <div class="space-y-3">
                <% estatisticas.pratosFavoritos.forEach((prato, index) => { %>
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <span class="w-8 h-8 bg-amber-100 rounded-full flex items-center justify-center text-sm font-semibold text-amber-700">
                        <%= index + 1 %>
                      </span>
                      <span class="font-medium text-stone-800"><%= prato.nome %></span>
                    </div>
                    <span class="text-stone-500 text-sm"><%= prato.quantidade %>x</span>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p class="text-stone-500 text-center py-4">Nenhum pedido registrado ainda</p>
            <% } %>
          </div>
        </div>

        <!-- Histórico de Pedidos -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 overflow-hidden">
            <div class="px-6 py-4 border-b border-stone-100">
              <h3 class="text-lg font-semibold text-stone-900">📋 Histórico de Pedidos</h3>
            </div>
            <div class="max-h-96 overflow-y-auto">
              <% if (pedidos.length > 0) { %>
                <div class="divide-y divide-stone-100">
                  <% pedidos.forEach(pedido => { %>
                    <div class="p-6 hover:bg-stone-50 transition">
                      <div class="flex items-start justify-between mb-3">
                        <div>
                          <p class="font-semibold text-stone-900">Pedido #<%= pedido.id %></p>
                          <p class="text-sm text-stone-500"><%= new Date(pedido.criado_em).toLocaleDateString('pt-BR') %> • <%= new Date(pedido.criado_em).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %></p>
                        </div>
                        <div class="text-right">
                          <p class="font-bold text-green-700">R$ <%= Number(pedido.total).toFixed(2) %></p>
                          <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium mt-1
                            <%= pedido.status === 'novo' ? 'bg-amber-100 text-amber-800' :
                                pedido.status === 'em_preparo' ? 'bg-blue-100 text-blue-800' :
                                pedido.status === 'finalizado' || pedido.status === 'entregue' ? 'bg-green-100 text-green-800' :
                                pedido.status === 'cancelado' ? 'bg-stone-200 text-stone-600' : 'bg-stone-100 text-stone-700' %>">
                            <%= pedido.status %>
                          </span>
                        </div>
                      </div>
                      
                      <% if (pedido.itens && pedido.itens.length > 0) { %>
                        <div class="bg-stone-50 rounded-lg p-3">
                          <ul class="space-y-1">
                            <% pedido.itens.forEach(item => { %>
                              <li class="text-sm text-stone-700 flex justify-between">
                                <span><%= item.nome_item %></span>
                                <span class="text-stone-500">×<%= item.quantidade %></span>
                              </li>
                            <% }); %>
                          </ul>
                        </div>
                      <% } %>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <div class="py-12 text-center text-stone-500">
                  <svg class="w-12 h-12 mx-auto mb-4 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                  </svg>
                  <p>Nenhum pedido registrado</p>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

</body>
</html>
