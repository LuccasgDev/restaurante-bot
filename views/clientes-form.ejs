<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { title: title }) %>
</head>
<body class="bg-stone-100 min-h-screen font-sans text-stone-800">

<div class="flex">
  <%- include('partials/sidebar', { active: 'clientes' }) %>

  <main class="flex-1 p-8">
    <div class="max-w-2xl mx-auto">
      <!-- Cabeçalho -->
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-stone-900"><%= title %></h1>
          <p class="text-stone-500 mt-1">Preencha os dados do cliente</p>
        </div>
        <a href="/admin/clientes" class="text-amber-600 hover:text-amber-700 font-medium flex items-center gap-2">
          ← Voltar
        </a>
      </div>

      <!-- Formulário -->
      <div class="bg-white rounded-2xl shadow-sm border border-stone-200/80 p-8">
        <form method="POST" action="<%= action %>" class="space-y-6">
          <!-- Nome -->
          <div>
            <label for="nome" class="block text-sm font-medium text-stone-700 mb-2">
              Nome Completo *
            </label>
            <input 
              type="text" 
              id="nome" 
              name="nome" 
              required
              value="<%= cliente.nome || '' %>"
              class="w-full border border-stone-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition"
              placeholder="Ex: Lucas Gabriel"
            />
          </div>

          <!-- Telefone -->
          <div>
            <label for="telefone" class="block text-sm font-medium text-stone-700 mb-2">
              Telefone *
            </label>
            <input 
              type="tel" 
              id="telefone" 
              name="telefone" 
              required
              value="<%= cliente.telefone || '' %>"
              <%= cliente.telefone ? 'readonly' : '' %>
              class="w-full border border-stone-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition <%= cliente.telefone ? 'bg-stone-50' : '' %>"
              placeholder="Ex: +55 85 9620-7714"
            />
            <% if (cliente.telefone) { %>
              <p class="text-xs text-stone-500 mt-1">Telefone não pode ser alterado</p>
            <% } %>
          </div>

          <!-- Endereço -->
          <div>
            <label for="endereco" class="block text-sm font-medium text-stone-700 mb-2">
              Endereço de Entrega
            </label>
            <textarea 
              id="endereco" 
              name="endereco" 
              rows="3"
              class="w-full border border-stone-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition resize-none"
              placeholder="Ex: Rua das Flores, 123 - Bairro Centro - Cidade/UF"
            ><%= cliente.endereco || '' %></textarea>
            <p class="text-xs text-stone-500 mt-1">Importante para entregas</p>
          </div>

          <!-- Observações -->
          <div>
            <label for="observacoes" class="block text-sm font-medium text-stone-700 mb-2">
              Observações
            </label>
            <textarea 
              id="observacoes" 
              name="observacoes" 
              rows="3"
              class="w-full border border-stone-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-amber-500/30 focus:border-amber-500 transition resize-none"
              placeholder="Alergias, preferências, informações adicionais..."
            ><%= cliente.observacoes || '' %></textarea>
            <p class="text-xs text-stone-500 mt-1">Alergias, restrições alimentares, preferências</p>
          </div>

          <!-- Botões -->
          <div class="flex gap-4 pt-4">
            <button 
              type="submit" 
              class="flex-1 bg-amber-600 hover:bg-amber-700 text-white font-medium py-3 px-6 rounded-xl transition shadow-sm"
            >
              <%= cliente.telefone ? 'Atualizar Cliente' : 'Cadastrar Cliente' %>
            </button>
            <a 
              href="/admin/clientes" 
              class="bg-stone-200 hover:bg-stone-300 text-stone-700 font-medium py-3 px-6 rounded-xl transition"
            >
              Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>

</body>
</html>
